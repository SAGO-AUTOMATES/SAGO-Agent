          "content": "#!/usr/bin/env python3\n\"\"\"\nSimple Calculator Program\nSupports addition, subtraction, multiplication, division.\nRun as script: python calculator.py\n\"\"\"\n\nclass Calculator:\n    def add(self, a, b):\n        return a + b\n\n    def subtract(self, a, b):\n        return a - b\n\n    def multiply(self, a, b):\n        return a * b\n\n    def divide(self, a, b):\n        if b == 0:\n            raise ValueError(\"Division by zero is not allowed.\")\n        return a / b\n\ndef main():\n    import sys\n    calc = Calculator()\n    if len(sys.argv) < 3:\n        print(\"Usage: python calculator.py <operation> <operand1> <operand2>\")\n        print(\"Operations: add, sub, mul, div\")\n        return\n    operation = sys.argv[1]\n    try:\n        a = float(sys.argv[2])\n        b = float(sys.argv[3])\n    except ValueError:\n        print(\"Error: Operands must be numbers.\")\n        return\n\n    if operation == \"add\":\n        result = calc.add(a, b)\n        op_symbol = \"+\"\n    elif operation == \"sub\":\n        result = calc.subtract(a, b)\n        op_symbol = \"-\"\n    elif operation == \"mul\":\n        result = calc.multiply(a, b)\n        op_symbol = \"*\"\n    elif operation == \"div\":\n        try:\n            result = calc.divide(a, b)\n            op_symbol = \"/\"\n        except ValueError as e:\n            print(f\"Error: {e}\")\n            return\n    else:\n        print(\"Error: Unsupported operation.\")\n        return\n\n    print(f\"{a} {op_symbol} {b} = {result}\")\n\nif __name__ == \"__main__\":\n    main()",
