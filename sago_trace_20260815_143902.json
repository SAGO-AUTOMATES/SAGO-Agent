          "content": "package main\n\nimport (\n\t\"fmt\"\n\t\"os\"\n\t\"strconv\"\n)\n\n// Calculator struct holds arithmetic operations\ntype Calculator struct{}\n\n// Add performs addition\nfunc (c *Calculator) Add(a, b float64) float64 {\n\treturn a + b\n}\n\n// Subtract performs subtraction\nfunc (c *Calculator) Subtract(a, b float64) float64 {\n\treturn a - b\n}\n\n// Multiply performs multiplication\nfunc (c *Calculator) Multiply(a, b float64) float64 {\n\treturn a * b\n}\n\n// Divide performs division with zero check\nfunc (c *Calculator) Divide(a, b float64) (float64, error) {\n\tif b == 0 {\n\t\treturn 0, fmt.Errorf(\"division by zero is not allowed\")\n\t}\n\treturn a / b, nil\n}\n\nfunc main() {\n\tif len(os.Args) < 4 {\n\t\tfmt.Println(\"Usage: go run calculator.go <operation> <operand1> <operand2>\")\n\t\tfmt.Println(\"Operations: add, sub, mul, div\")\n\t\tos.Exit(1)\n\t}\n\n\toperation := os.Args[1]\n\ta, err := strconv.ParseFloat(os.Args[2], 64)\n\tif err != nil {\n\t\tfmt.Printf(\"Error: %s is not a valid number\\n\", os.Args[2])\n\t\tos.Exit(1)\n\t}\n\n\tb, err := strconv.ParseFloat(os.Args[3], 64)\n\tif err != nil {\n\t\tfmt.Printf(\"Error: %s is not a valid number\\n\", os.Args[3])\n\t\tos.Exit(1)\n\t}\n\n\tcalc := &Calculator{}\n\tvar result float64\n\tvar opSymbol string\n\n\tswitch operation {\n\tcase \"add\":\n\t\tresult = calc.Add(a, b)\n\t\topSymbol = \"+\"\n\tcase \"sub\":\n\t\tresult = calc.Subtract(a, b)\n\t\topSymbol = \"-\"\n\tcase \"mul\":\n\t\tresult = calc.Multiply(a, b)\n\t\topSymbol = \"*\"\n\tcase \"div\":\n\t\tvar err error\n\t\tresult, err = calc.Divide(a, b)\n\t\topSymbol = \"/\"\n\t\tif err != nil {\n\t\t\tfmt.Printf(\"Error: %v\\n\", err)\n\t\t\tos.Exit(1)\n\t\t}\n\tdefault:\n\t\tfmt.Printf(\"Error: unsupported operation '%s'\\n\", operation)\n\t\tos.Exit(1)\n\t}\n\n\tfmt.Printf(\"%.1f %s %.1f = %.1f\\n\", a, opSymbol, b, result)\n}",
