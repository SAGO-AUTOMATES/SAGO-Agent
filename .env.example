# Sago Environment Variables
# Copy this file to .env and fill in your API keys

# Gemini (Google)
GEMINI_API_KEY=

# OpenAI (GPT)
OPENAI_API_KEY=

# Claude (Anthropic)
ANTHROPIC_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Ollama (local - no key needed, just ensure server is running)
# OLLAMA_BASE_URL=http://localhost:11434
